# ==============================================================================
# VaruNet Environment Variables Configuration Template
# Copy this file to .env before starting the services: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 15 + PostGIS)
POSTGRES_DB=varunet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# FastAPI Backend Service
ENVIRONMENT=production
PORT=8000
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (Vite + React)
VITE_API_URL=http://localhost:8000/api

# Monitoring Services
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
